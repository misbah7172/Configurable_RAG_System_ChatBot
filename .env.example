# ===== Database (NeonDB PostgreSQL) =====
# Use your NeonDB connection string here
# Format: postgresql+asyncpg://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Sync URL for Alembic migrations (replace +asyncpg with psycopg2)
DATABASE_URL_SYNC=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ===== Qdrant (Vector Database) =====
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ===== Redis (Cache & Queue) =====
REDIS_URL=redis://localhost:6379/0

# ===== MinIO (S3-Compatible Object Storage) =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents
MINIO_SECURE=false

# ===== FastAPI =====
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
SECRET_KEY=change-me-in-production-use-a-random-string

# ===== LLM Providers (Optional — configure later) =====
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AIza...

# ===== Default Tenant (Dev) =====
DEFAULT_TENANT_ID=default
DEFAULT_TENANT_NAME=Development
